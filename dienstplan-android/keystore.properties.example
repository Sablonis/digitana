# Vorlage: nach keystore.properties kopieren und ausfüllen. keystore.properties NIE einchecken
# (steht in .gitignore). Alternativ Umgebungsvariablen setzen:
#   DIENSTPLAN_KEYSTORE, DIENSTPLAN_KEYSTORE_PASSWORD, DIENSTPLAN_KEY_ALIAS, DIENSTPLAN_KEY_PASSWORD
# Pfade sind relativ zum Projektordner (dienstplan-android/) oder absolut.
storeFile=../../keys/dienstplan-release.jks
storePassword=HIER_KEYSTORE_PASSWORT
keyAlias=dienstplan
keyPassword=HIER_SCHLUESSEL_PASSWORT
